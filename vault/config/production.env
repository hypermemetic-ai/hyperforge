# Who the vault serves. Public values, no secret: the client id is the whole of
# every device sign-in request. Menger's WorkOS client, production environment (from
# menger/deploy/env/app-prod.env, MENGER_AUTH_PROVIDERS). The client is shared,
# so VAULT_OWNER_USER_ID is what keeps its other users out.
VAULT_WORKOS_CLIENT_ID=client_01M4GRE1PVRFQJ7T4EMSK4MQKN
VAULT_OWNER_USER_ID=user_01M55D3MW1VT81ZJA44KFXJY4C
